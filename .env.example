# ─────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Worker (FastAPI) — integrações, jobs e bot
# ─────────────────────────────────────────────────────────────
WORKER_BASE_URL=http://127.0.0.1:8000

# Segredo compartilhado entre o painel (Next.js) e o worker.
# Autentica as chamadas internas via HMAC-SHA256.
# Gere com: openssl rand -hex 32
INTERNAL_API_SECRET=

# Chave-mestra de criptografia dos certificados digitais (AES-256-GCM).
# 32 bytes em hex. NUNCA compartilhe e NUNCA guarde no Supabase.
# Gere com: openssl rand -hex 32
CERT_MASTER_KEY=

# ─────────────────────────────────────────────────────────────
# Banco (worker)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres

# ─────────────────────────────────────────────────────────────
# Storage dos certificados e PDFs
# local  = sistema de arquivos (desenvolvimento)
# supabase = bucket privado do Supabase Storage
# ─────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./.data/storage

# ─────────────────────────────────────────────────────────────
# SERPRO Integra Contador
# mock = fixtures locais (use até a API ser contratada)
# serpro = API real
# ─────────────────────────────────────────────────────────────
INTEGRA_PROVIDER=mock
SERPRO_AMBIENTE=trial
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
SERPRO_CONTRATANTE_CNPJ=

# ─────────────────────────────────────────────────────────────
# Evolution API (WhatsApp)
# ─────────────────────────────────────────────────────────────
EVOLUTION_BASE_URL=http://127.0.0.1:8080
EVOLUTION_INSTANCE=vrf
EVOLUTION_APIKEY=
EVOLUTION_WEBHOOK_TOKEN=
